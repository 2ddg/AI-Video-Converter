{
  "name": "video-converter",
  "version": "1.0.0",
  "description": "视频格式转换器 - Electron 桌面客户端",
  "main": "out/main/index.js",
  "author": "PangJianfeng",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "icon": "resources\\ffmpeg\\ffmpeg.exe -y -i build\\icon.png -vf scale=256:256 -f ico build\\icon.ico"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "electron@44.8.0": true
  }
}
